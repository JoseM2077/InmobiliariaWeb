<%--
  seguridad.jspf - Control de acceso por sesión y roles
  Proyecto: InmobiliariaWeb
  Uso en páginas protegidas:
      <% String[] rolesPermitidos = {"AGENTE", "ADMIN"}; %>
      <%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
--%>
<%@ page import="java.util.List" %>
<%
    Integer idUsuarioSesion = (Integer) session.getAttribute("idUsuario");
    String  rolSesion       = (String)  session.getAttribute("rol");
    @SuppressWarnings("unchecked")
    List<String> rolesSesion= (List<String>) session.getAttribute("roles");
    String  nombreSesion    = (String)  session.getAttribute("nombre");
    String  correoSesion    = (String)  session.getAttribute("correo");

    // 1) Si no hay sesión activa, redirigir a login
    if (idUsuarioSesion == null) {
        response.sendRedirect(request.getContextPath() + "/login.jsp?error=sesion");
        return;
    }

    // 2) Si se especificaron roles permitidos, validar si el usuario posee al menos uno
    if (rolesPermitidos != null && rolesPermitidos.length > 0) {
        boolean autorizado = false;
        for (String rolPermitido : rolesPermitidos) {
            if (rolPermitido != null) {
                if (rolPermitido.equalsIgnoreCase(rolSesion)) {
                    autorizado = true;
                    break;
                }
                if (rolesSesion != null) {
                    for (String r : rolesSesion) {
                        if (rolPermitido.equalsIgnoreCase(r)) {
                            autorizado = true;
                            break;
                        }
                    }
                }
            }
            if (autorizado) break;
        }

        if (!autorizado) {
            response.sendRedirect(request.getContextPath() + "/landing.jsp?error=permiso");
            return;
        }
    }
%>
