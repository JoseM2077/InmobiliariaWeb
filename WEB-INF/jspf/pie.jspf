<%--
  pie.jspf - Cierre del contenedor principal, pie de página y scripts de Bootstrap
  Proyecto: InmobiliariaWeb
--%>
</main>

<!-- Pie de página institucional -->
<footer class="bg-navy text-white mt-5 pt-5 pb-3 border-top">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-4 col-md-6">
        <h5 class="fw-bold text-warning d-flex align-items-center gap-2">
          <i class="bi bi-buildings-fill"></i> Inmobiliaria Horizonte
        </h5>
        <p class="text-white-50 small mt-2">
          Líderes en comercialización de inmuebles en Bucaramanga y su área metropolitana. 
          Encuentre con nosotros la casa, apartamento, oficina o lote que sueña para su futuro o inversión.
        </p>
        <div class="d-flex gap-3 fs-5 text-white-50">
          <a href="#" class="text-white-50 text-decoration-none"><i class="bi bi-facebook"></i></a>
          <a href="#" class="text-white-50 text-decoration-none"><i class="bi bi-instagram"></i></a>
          <a href="#" class="text-white-50 text-decoration-none"><i class="bi bi-whatsapp"></i></a>
          <a href="#" class="text-white-50 text-decoration-none"><i class="bi bi-linkedin"></i></a>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <h6 class="text-uppercase fw-bold text-light mb-3">Enlaces Rápidos</h6>
        <ul class="list-unstyled small text-white-50">
          <li class="mb-2"><a href="<%= ctx %>/landing.jsp" class="text-white-50 text-decoration-none"><i class="bi bi-chevron-right text-warning"></i> Inicio</a></li>
          <li class="mb-2"><a href="<%= ctx %>/landing.jsp#catalogo" class="text-white-50 text-decoration-none"><i class="bi bi-chevron-right text-warning"></i> Catálogo de Inmuebles</a></li>
          <li class="mb-2"><a href="<%= ctx %>/registro.jsp" class="text-white-50 text-decoration-none"><i class="bi bi-chevron-right text-warning"></i> Registro de Clientes</a></li>
          <li class="mb-2"><a href="<%= ctx %>/login.jsp" class="text-white-50 text-decoration-none"><i class="bi bi-chevron-right text-warning"></i> Portal de Acceso</a></li>
        </ul>
      </div>

      <div class="col-lg-2 col-md-6">
        <h6 class="text-uppercase fw-bold text-light mb-3">Servicios</h6>
        <ul class="list-unstyled small text-white-50">
          <li class="mb-2"><i class="bi bi-check2 text-warning me-1"></i> Venta de Propiedades</li>
          <li class="mb-2"><i class="bi bi-check2 text-warning me-1"></i> Arriendos Garantizados</li>
          <li class="mb-2"><i class="bi bi-check2 text-warning me-1"></i> Avalúos Certificados</li>
          <li class="mb-2"><i class="bi bi-check2 text-warning me-1"></i> Asesoría Jurídica</li>
        </ul>
      </div>

      <div class="col-lg-3 col-md-6">
        <h6 class="text-uppercase fw-bold text-light mb-3">Sede Principal</h6>
        <p class="small text-white-50 mb-1">
          <i class="bi bi-geo-alt-fill text-warning me-1"></i> Calle 35 # 28-15, Cabecera, Bucaramanga
        </p>
        <p class="small text-white-50 mb-1">
          <i class="bi bi-telephone-fill text-warning me-1"></i> (607) 634-5678 / 315-789-0123
        </p>
        <p class="small text-white-50">
          <i class="bi bi-envelope-fill text-warning me-1"></i> contacto@inmobiliariahorizonte.com
        </p>
      </div>
    </div>

    <hr class="border-secondary my-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center small text-white-50">
      <div>
        &copy; 2026 Inmobiliaria Horizonte S.A.S. &middot; Todos los derechos reservados.
      </div>
      <div>
        UTS &middot; Tecnología en Desarrollo de Sistemas Informáticos &middot; Java EE JSP + JDBC
      </div>
    </div>
  </div>
</footer>

<!-- JavaScript de Bootstrap 5.3 Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
