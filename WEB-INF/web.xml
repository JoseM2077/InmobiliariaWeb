<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.xml - Descriptor de despliegue de la aplicación InmobiliariaWeb.
  Java EE 8 / Servlet 4.0 para Apache Tomcat 9/10.
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>InmobiliariaWeb</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>landing.jsp</welcome-file>
    </welcome-file-list>

    <!-- La sesión caduca a los 30 minutos de inactividad -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Todas las páginas JSP se procesan y emiten en UTF-8 -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
        </jsp-property-group>
    </jsp-config>

    <!-- Manejo amigable de páginas de error HTTP -->
    <error-page>
        <error-code>404</error-code>
        <location>/landing.jsp</location>
    </error-page>

</web-app>
