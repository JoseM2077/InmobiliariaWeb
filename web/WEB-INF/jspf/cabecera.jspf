<%--
  cabecera.jspf - Encabezado HTML y barra de navegación dinámica por rol
  Proyecto: InmobiliariaWeb
  Roles soportados: VISITANTE (sin sesión), CLIENTE, AGENTE, ADMIN.
  Requiere antes: String tituloPagina = "Título";
--%>
<%@ page import="java.util.List" %>
<%
    String ctx = request.getContextPath();
    Integer idUsuarioCabecera = (Integer) session.getAttribute("idUsuario");
    String  rolCabecera       = (String)  session.getAttribute("rol");
    String  nombreCabecera    = (String)  session.getAttribute("nombre");
    String  correoCabecera    = (String)  session.getAttribute("correo");
    boolean esVisitante       = (idUsuarioCabecera == null);
    if (rolCabecera == null) rolCabecera = "VISITANTE";
    if (nombreCabecera == null) nombreCabecera = "Invitado";

    // Determina si la vista requiere ancho completo (ej. Landing Page)
    String uriActual = request.getRequestURI();
    boolean esLanding = uriActual.endsWith("landing.jsp") || uriActual.endsWith("/");
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= (tituloPagina != null ? tituloPagina : "Inicio") %> | Inmobiliaria Horizonte</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Iconos de Bootstrap 1.11 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Estilos Propios -->
    <link href="<%= ctx %>/css/estilos.css" rel="stylesheet">
</head>
<body class="bg-light">

<!-- Barra de navegación principal -->
<nav class="navbar navbar-expand-lg navbar-dark bg-navy sticky-top shadow">
  <div class="container">
    <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="<%= ctx %>/<%= esVisitante ? "landing.jsp" : "inicio.jsp" %>">
        <i class="bi bi-buildings-fill text-warning fs-3"></i>
        <span>Inmobiliaria <span class="text-warning">Horizonte</span></span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavbar" aria-controls="menuNavbar" aria-expanded="false" aria-label="Navegación">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="menuNavbar">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        
        <%-- ================= VISTA VISITANTE ================= --%>
        <% if (esVisitante) { %>
          <li class="nav-item">
            <a class="nav-link <%= esLanding ? "active fw-semibold" : "" %>" href="<%= ctx %>/landing.jsp">
              <i class="bi bi-house"></i> Inicio
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/landing.jsp#catalogo">
              <i class="bi bi-search"></i> Catálogo de Inmuebles
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/landing.jsp#nosotros">
              <i class="bi bi-info-circle"></i> Nosotros
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/landing.jsp#contacto">
              <i class="bi bi-telephone"></i> Contacto
            </a>
          </li>
        <% } %>

        <%-- ================= VISTA CLIENTE ================= --%>
        <% if (!esVisitante && "CLIENTE".equalsIgnoreCase(rolCabecera)) { %>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/inicio.jsp">
              <i class="bi bi-grid-1x2-fill"></i> Panel Cliente
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/landing.jsp#catalogo">
              <i class="bi bi-search"></i> Explorar Propiedades
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/cliente/citas.jsp">
              <i class="bi bi-calendar-check"></i> Mis Citas
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/cliente/solicitudes.jsp">
              <i class="bi bi-file-earmark-text"></i> Mis Solicitudes
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/cliente/favoritos.jsp">
              <i class="bi bi-heart-fill text-danger"></i> Favoritos
            </a>
          </li>
        <% } %>

        <%-- ================= VISTA AGENTE / INMOBILIARIA ================= --%>
        <% if (!esVisitante && "AGENTE".equalsIgnoreCase(rolCabecera)) { %>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/inicio.jsp">
              <i class="bi bi-speedometer2"></i> Tablero Agente
            </a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
              <i class="bi bi-building"></i> Propiedades
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="<%= ctx %>/agente/propiedades.jsp"><i class="bi bi-list-ul"></i> Mis Propiedades</a></li>
              <li><a class="dropdown-item" href="<%= ctx %>/agente/nueva_propiedad.jsp"><i class="bi bi-plus-circle"></i> Publicar Inmueble</a></li>
            </ul>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/agente/citas.jsp">
              <i class="bi bi-calendar-event"></i> Agenda de Citas
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/agente/solicitudes.jsp">
              <i class="bi bi-folder-check"></i> Solicitudes Recibidas
            </a>
          </li>
        <% } %>

        <%-- ================= VISTA ADMINISTRADOR ================= --%>
        <% if (!esVisitante && "ADMIN".equalsIgnoreCase(rolCabecera)) { %>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/inicio.jsp">
              <i class="bi bi-speedometer"></i> Panel Admin
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/admin/usuarios.jsp">
              <i class="bi bi-people-fill"></i> Usuarios y Roles
            </a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
              <i class="bi bi-sliders"></i> Catálogos
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="<%= ctx %>/admin/ciudades.jsp"><i class="bi bi-geo-alt"></i> Ciudades</a></li>
              <li><a class="dropdown-item" href="<%= ctx %>/admin/tipos.jsp"><i class="bi bi-tag"></i> Tipos de Inmuebles</a></li>
              <li><a class="dropdown-item" href="<%= ctx %>/admin/caracteristicas.jsp"><i class="bi bi-stars"></i> Características</a></li>
            </ul>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/admin/propiedades.jsp">
              <i class="bi bi-buildings"></i> Propiedades
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= ctx %>/admin/reportes.jsp">
              <i class="bi bi-graph-up"></i> Reportes
            </a>
          </li>
        <% } %>

      </ul>

      <%-- Menú de acceso / perfil a la derecha --%>
      <div class="d-flex align-items-center gap-2">
        <% if (esVisitante) { %>
          <a href="<%= ctx %>/login.jsp" class="btn btn-outline-light btn-sm px-3">
            <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
          </a>
          <a href="<%= ctx %>/registro.jsp" class="btn btn-warning btn-sm px-3 fw-semibold">
            <i class="bi bi-person-plus-fill"></i> Registrarse
          </a>
        <% } else { %>
          <div class="dropdown">
            <button class="btn btn-outline-light btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle fs-5"></i>
              <span><%= nombreCabecera %></span>
              <span class="badge <%= "ADMIN".equalsIgnoreCase(rolCabecera) ? "text-bg-danger" : ("AGENTE".equalsIgnoreCase(rolCabecera) ? "text-bg-primary" : "text-bg-success") %>">
                <%= rolCabecera %>
              </span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
              <li class="px-3 py-1 text-muted small">
                <i class="bi bi-envelope"></i> <%= correoCabecera %>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item" href="<%= ctx %>/perfil.jsp">
                  <i class="bi bi-person-badge"></i> Mi Perfil
                </a>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item text-danger fw-semibold" href="<%= ctx %>/logout.jsp">
                  <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                </a>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<!-- Contenedor de contenido principal -->
<main class="<%= esLanding ? "w-100" : "container my-4" %>">
